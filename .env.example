# Copy to .env and edit. Never commit .env.

# Postgres password. Use URL-safe characters only (letters, digits, - _ .): it goes into a URL.
POSTGRES_PASSWORD=change-me

# "ollama" runs Ollama in a container. On macOS, set this empty and run Ollama natively
# (Docker on macOS can't use the Apple GPU), then point the app at it:
#   COMPOSE_PROFILES=
#   MAYAKB_OLLAMA_URL=http://host.docker.internal:11434
COMPOSE_PROFILES=ollama
MAYAKB_OLLAMA_URL=http://ollama:11434

# Models pulled into the ollama container on first start (space separated)
MAYAKB_OLLAMA_MODELS=nomic-embed-text

# Only for knowledge bases that use the llamaparse parser
LLAMA_CLOUD_API_KEY=
